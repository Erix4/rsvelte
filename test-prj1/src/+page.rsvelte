<script>
    import Button from "./Button.rsvelte";

    struct $state {
        counter = $state(0),
        button1 = $state(1),
        button2 = $state(2),
    }
</script>

<div>
    <button onclick={|| counter += 1}>Increment</button>
    <Button n={button1}/>
    <Button n={counter}/>
    <p>
        Hello world!
        {#if counter > 5}
            <p>Bye!</p>
        {:else}
            <p>Hi!</p>
        {/if}
    </p>
    <p>Counter: {counter}</p>
    {#each 0..counter as i}
        <div class="count-row">
        {#each 0..*i as j}
            <p>{i} {j}</p>
            <Button n={j}/>
        {/each}
        </div>
    {/each}
</div>

<style>
    :global(p) {
        margin: 0;
    }

    .count-row {
        display: flex;
        margin: 4px;
        width: fit-content;
    }

    .count-row p {
        margin: 0 4px 0 0;
        background-color: #f0f0f0;
        border-radius: 4px;
        padding: 4px;
    }

</style>